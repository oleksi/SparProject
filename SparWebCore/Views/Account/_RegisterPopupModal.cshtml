@*
    Partial used for the registration popup. Returned by AccountController.GetRegisterPopupModal()
*@
<div class="modal-header">
    <h5 class="modal-title">Register</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
</div>
<div class="modal-body">
    <p>Registration is currently stubbed for migration testing. <a href="/Account/Register">Go to register page</a></p>
    <form id="quickRegisterForm">
        <div class="form-group"><input class="form-control" placeholder="Email" /></div>
        <button class="btn btn-primary">Register</button>
    </form>
</div>
